# ==============================================================================
# ActTrident AI Sales Outreach & Automation Agent - Environment Configuration
# Copy to .env and replace all placeholder values before starting.
# NEVER commit your real .env file to Git.
# ==============================================================================

# General & Security
PROJECT_NAME="ActTrident AI Outreach Agent"
ENVIRONMENT="development"
TIMEZONE="Asia/Kolkata"

# Generate unique secrets (>= 32 chars for SECRET_KEY and APPROVAL_SECRET_KEY, Fernet or >= 16 char key for CREDENTIAL_ENCRYPTION_KEY)
SECRET_KEY="replace-with-a-unique-random-secret-key-at-least-32-characters-long"
APPROVAL_SECRET_KEY="replace-with-a-unique-random-approval-hmac-key-at-least-32-chars"
CREDENTIAL_ENCRYPTION_KEY="replace-with-a-unique-fernet-or-high-entropy-encryption-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Explicit CORS Origins (Comma-separated; NEVER use * in production)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database (PostgreSQL mandatory in production; SQLite permitted for local development only)
DATABASE_URL="sqlite:///./acttrident.db"
# Production PostgreSQL example:
# POSTGRES_USER="acttrident"
# POSTGRES_PASSWORD="replace-with-strong-postgres-password"
# POSTGRES_DB="acttrident_db"
# DATABASE_URL="postgresql://acttrident:replace-with-strong-postgres-password@postgres:5432/acttrident_db"

# Redis & Celery Background Engine
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# AI Provider (mock | gemini | openai)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MODEL_NAME="gemini-1.5-pro"

# Email Delivery (resend primary | mock | gmail | smtp)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_WEBHOOK_SECRET=""
EMAIL_TEST_MODE_ENABLED=true
EMAIL_TEST_ALLOWLIST=""
EMAIL_DKIM_SELECTOR="resend"
PUBLIC_BASE_URL="http://localhost:8000"
LIVE_SEND_ENABLED=false
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:8000/api/v1/integrations/gmail/oauth/callback"

# SMTP Fallback (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="ActTrident Business Development"
SMTP_FROM_EMAIL="outreach@acttrident.ai"
SMTP_USE_TLS=true

# Official Meta WhatsApp Business Cloud API
WHATSAPP_ENABLED=true
META_WA_ACCESS_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
META_WA_BUSINESS_ACCOUNT_ID=""
META_WA_VERIFY_TOKEN="replace-with-meta-webhook-verify-token"
META_APP_SECRET=""

# Official LinkedIn OAuth 2.0 (NEVER password or cookie extraction)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:8000/api/v1/integrations/linkedin/oauth/callback"
LINKEDIN_API_SCOPES="openid profile email"
LINKEDIN_MESSAGING_API_APPROVED=false
LINKEDIN_PARTNER_MESSAGING_ENDPOINT=""

# Real Lead Discovery Search Providers (Optional)
TAVILY_API_KEY=""
SERPAPI_API_KEY=""

# Conservative Sending & Rate Limits
DEFAULT_DAILY_EMAIL_LIMIT=50
DEFAULT_DAILY_WHATSAPP_LIMIT=20
OUTBOUND_RATE_LIMIT_EMAIL_PER_MIN=30
OUTBOUND_RATE_LIMIT_WA_PER_MIN=10
REQUIRE_HUMAN_APPROVAL=true
