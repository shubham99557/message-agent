# ==============================================================================
# ActTrident AI Outreach & Sales Automation Agent - Environment Configuration
# ==============================================================================

# General
PROJECT_NAME="ActTrident AI Outreach Agent"
SECRET_KEY="generate-a-secure-random-256-bit-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL for Docker / Production, SQLite for local testing)
# Example for Docker Compose:
DATABASE_URL="postgresql://acttrident:ActTridentSecure2026!@postgres:5432/acttrident_db"
# Example for local development:
# DATABASE_URL="sqlite:///./acttrident.db"

# AI Provider Configuration (gemini, openai, mock)
AI_PROVIDER="mock"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MODEL_NAME="gemini-1.5-pro"

# Email Configuration (SMTP / Gmail API / mock)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="outreach@acttrident.ai"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM_NAME="ActTrident Business Development"
SMTP_FROM_EMAIL="outreach@acttrident.ai"
SMTP_USE_TLS=true

# Official Meta WhatsApp Business Cloud API Configuration
WHATSAPP_ENABLED=true
META_WA_ACCESS_TOKEN="EAABYourPermanentSystemUserTokenFromMeta"
META_WA_PHONE_NUMBER_ID="your_phone_number_id"
META_WA_BUSINESS_ACCOUNT_ID="your_waba_account_id"
META_WA_VERIFY_TOKEN="acttrident_meta_webhook_secret_2026"

# Conservative Sending & Safety Limits
DEFAULT_DAILY_EMAIL_LIMIT=50
DEFAULT_DAILY_WHATSAPP_LIMIT=20
REQUIRE_HUMAN_APPROVAL=true
